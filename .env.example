# Server
PORT=3001

# Log level: INFO (default) logs tool calls and external token endpoint requests.
# DEBUG additionally logs incoming/exchanged tokens and their JWT claims.
LOG_LEVEL=INFO

# OAuth Token Exchange (RFC 8693)
# Token endpoint of the Authorization Server that will perform the exchange
TOKEN_EXCHANGE_URL=https://as.example.com/oauth2/token

# Client credentials for RFC 8693 token exchange (same-domain)
CLIENT_ID_TE_SAME_DOMAIN=mcp-marketplace-acl-client
CLIENT_SECRET_TE_SAME_DOMAIN=<your-client-secret>

# Client credentials for RFC 7523 JWT Bearer grant (other-domain)
CLIENT_ID_JWT_OTHER_DOMAIN=mcp-marketplace-acl-jwt-client
CLIENT_SECRET_JWT_OTHER_DOMAIN=<your-jwt-client-secret>

# Target resource for RFC 8693 token exchange (replaces aud claim)
TOKEN_EXCHANGE_TARGET_RESOURCE=https://api.runlocal.dev/httpbin

# Space-separated scopes for the RFC 8693 exchanged token
TOKEN_EXCHANGE_TARGET_SCOPES=httpbin:read httpbin:write

# Token endpoint for RFC 7523 JWT Bearer grant (defaults to TOKEN_EXCHANGE_URL if unset)
JWT_BEARER_TOKEN_EXCHANGE_URL=https://as.example.com/oauth2/token

# Target resource for RFC 7523 JWT Bearer grant (defaults to TOKEN_EXCHANGE_TARGET_RESOURCE if unset)
JWT_BEARER_TARGET_RESOURCE=https://api.runlocal.dev/httpbin

# Space-separated scopes for the RFC 7523 JWT Bearer token (defaults to TOKEN_EXCHANGE_TARGET_SCOPES if unset)
JWT_BEARER_TARGET_SCOPES=httpbin:read httpbin:write
